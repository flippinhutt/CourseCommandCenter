{
	"name": "course-command-center",
	"version": "0.1.0",
	"description": "Delivery-aware academic dashboard and workflow layer for an Obsidian course vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src main.ts --ext .ts",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flippinhutt/CourseCommandCenter.git"
	},
	"bugs": {
		"url": "https://github.com/flippinhutt/CourseCommandCenter/issues"
	},
	"homepage": "https://github.com/flippinhutt/CourseCommandCenter#readme",
	"author": "Ryan Hutto",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^8.57.0",
		"obsidian": "^1.5.7",
		"tslib": "2.6.2",
		"typescript": "5.3.3",
		"vitest": "^1.3.1"
	}
